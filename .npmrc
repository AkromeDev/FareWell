# No package runs an install script. The build, the prerender and the tests need none:
# esbuild, lmdb, @parcel/watcher and msgpackr-extract come as prebuilt packages for each
# system, and fsevents is only loaded on a Mac.
ignore-scripts=true
# Versions are written exactly, never with ^ or ~, so a lockfile refresh cannot move them.
save-exact=true
